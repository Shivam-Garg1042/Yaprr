# ── yaprr platform ────────────────────────────────────────────────────
YAPRR_API_URL=http://localhost:8000
YAPRR_WORKER_TOKEN=change-me        # same as WORKER_TOKEN in apps/api/.env
WORKER_AGENT_NAME=yaprr-agent       # empty = auto-dispatch to every room (no agent from DB)
# DEFAULT_AGENT_ID=                 # agent used by `python main.py console`; else local demo agent

# Provider keys for agents that pick these LLMs in the UI
GROQ_API_KEY=
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=

# ── Required credentials ──────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
DEEPGRAM_API_KEY=your_deepgram_api_key
GOOGLE_API_KEY=your_google_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# ── Voice pipeline (optional — sensible defaults in services/config.py) ─
# STT_MODEL=nova-3
# STT_LANGUAGE=multi           # or hi (Nova-3 supports Hindi; multi mis-hears Hindi as English sometimes)
# LLM_PROVIDER=google          # or openai (set OPENAI_API_KEY; LLM_BASE_URL for Groq etc.)
# LLM_BASE_URL=               # Groq: https://api.groq.com/openai/v1  Cerebras: https://api.cerebras.ai/v1
# LLM_API_KEY=                # key for that provider (else OPENAI_API_KEY is used)
# LLM_REASONING_EFFORT=        # Groq qwen: none | gpt-oss: low
# LLM_FALLBACKS=openai:gpt-4.1-mini,google:gemini-3.5-flash   # ordered; provider:model[:reasoning]; empty = off
# LLM_ATTEMPT_TIMEOUT=4
# GROQ_API_KEY=               # only for scripts/llm_bench.py
# CEREBRAS_API_KEY=           # only for scripts/llm_bench.py

# ── Noise ─────────────────────────────────────────────────────────────
# NOISE_CANCELLATION=bvc        # bvc | bvc_telephony (phone/SIP) | none. Not active in console mode
# LLM_VERTEX=false             # true = Gemini via Vertex AI (region below); run gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=asia-south1
# LLM_MODEL=gemini-3.5-flash-lite   # gemini-2.5-flash now 404s for new API keys
# TTS_MODEL=sonic-3
# TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
# TTS_LANGUAGE=hi
# TTS_SPEED=1.0
# USE_TURN_DETECTOR=true        # set false to fall back to plain VAD endpointing
# LLM_TEMPERATURE=0.5
# LLM_THINKING_LEVEL=minimal    # Gemini 3.x (minimal|low|medium|high). Some models reject minimal
# LLM_THINKING_BUDGET=0         # Gemini 2.x only: 0 = no thinking tokens

# ── Latency / turn-taking (see docs/BUILD_LOG.md entry 2) ─────────────
# VAD_MIN_SPEECH=0.05
# VAD_MIN_SILENCE=0.35          # lib default 0.55
# VAD_ACTIVATION=0.5
# ENDPOINT_MIN_DELAY=0.4        # lib default 0.5
# ENDPOINT_MAX_DELAY=2.0
# ALLOW_INTERRUPTIONS=true
# INTERRUPT_MIN_DURATION=0.5
# INTERRUPT_MIN_WORDS=0
# FALSE_INTERRUPTION_TIMEOUT=2.0
# PREEMPTIVE_GENERATION=true

# ── Safety ────────────────────────────────────────────────────────────
# MAX_CALL_SECONDS=360
# USER_AWAY_TIMEOUT=12
# MAX_INACTIVITY_PROMPTS=2

# ── Cost estimate unit prices (USD) — set to your real plan ───────────
# PRICE_STT_USD_PER_MIN=0.0077
# PRICE_LLM_USD_PER_M_INPUT=0.30
# PRICE_LLM_USD_PER_M_OUTPUT=2.50
# PRICE_TTS_USD_PER_M_CHARS=45
# PRICE_PLATFORM_USD_PER_MIN=0
# USD_TO_INR=88

# ── Post-call dispositions ────────────────────────────────────────────
# DISPOSITIONS_ENABLED=true
# DISPOSITION_MODEL=gemini-3.5-flash

# ── Local-dev settings ────────────────────────────────────────────────
EVENTS_LOG_PATH=runtime/call_events.jsonl
CALL_RECORDS_DIR=runtime/calls

