# Postgres (docker compose up -d) ...
DATABASE_URL=postgresql+psycopg://yaprr:yaprr@localhost:5432/yaprr
# ... or no Docker at all:
# DATABASE_URL=sqlite:///./yaprr.db

# Shared secret with the worker (same value as YAPRR_WORKER_TOKEN there)
WORKER_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173

# Same LiveKit project as the worker; used to mint "Talk to agent" tokens
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WORKER_AGENT_NAME=yaprr-agent
SEED_DEMO_AGENTS=true
# Dashboard/API access token. Empty = open (local only). ALWAYS set it on a public deploy.
ADMIN_TOKEN=

# Public read-only dashboards (no token needed to look)
PUBLIC_READ=false
# Show transcripts to visitors too (the /try page warns callers)
PUBLIC_TRANSCRIPTS=true
# Public /try demo, with spend caps: worst case per day = DEMO_MINUTES_PER_DAY x ~Rs 3
DEMO_ENABLED=false
DEMO_AGENT_ID=
DEMO_MAX_CALL_SECONDS=120
DEMO_CALLS_PER_IP_PER_DAY=3
DEMO_MINUTES_PER_DAY=60
