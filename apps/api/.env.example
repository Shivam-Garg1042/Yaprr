# Postgres (docker compose up -d) ...
DATABASE_URL=postgresql+psycopg://yaprr:yaprr@localhost:5432/yaprr
# ... or no Docker at all:
# DATABASE_URL=sqlite:///./yaprr.db

# Shared secret with the worker (same value as YAPRR_WORKER_TOKEN there)
WORKER_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173

# Same LiveKit project as the worker; used to mint "Talk to agent" tokens
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WORKER_AGENT_NAME=yaprr-agent
SEED_DEMO_AGENTS=true
